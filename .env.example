# Alpha platform environment (root)
# Copy ke .env lalu isi nilai rahasia. JANGAN commit .env.
# Port registry (satu-satunya sumber): gateway 8444, domain 8450-8455.

# ── Gateway ─────────────────────────────────────────────
ALPHA_GATEWAY_PORT=8444
# Override target service (default localhost). Format: name=url,name=url
# ALPHA_GATEWAY_TARGETS=platform=http://localhost:8450,...

# ── Domain services ─────────────────────────────────────
ALPHA_SERVICE_PORT=8450   # di-override per container/compose

# ── Database (dipakai semua service, stage-1 shared DB) ─
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_tracker?schema=public

# ── Security (WAJIB bukan default di production) ────────
SECRET_KEY=
FINANCE_TRACKER_CORS_ORIGINS=http://localhost:3000

# ── Opsional ────────────────────────────────────────────
DEBUG=false
ENABLE_TELEGRAM_POLL=0
GEMINI_API_KEY=
