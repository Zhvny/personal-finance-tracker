      "name": "HTTP Request - GET /api/health-score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        440
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "alpha-api-key-cred-id",
          "name": "Alpha API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Compose weekly finance digest from canonical, explainable backend data\nconst insights = $input.first().json;\nconst health = $node['HTTP Request - GET /api/health-score'].json;\n\nconst fmt = (n) => 'Rp ' + Math.round(n || 0).toLocaleString('id-ID');\n\nconst severityLabel = {\n  alert: 'Alert',\n  warning: 'Perhatian',\n  positive: 'Positif',\n  info: 'Info'\n};\n\nconst lines = [\n  '*Ringkasan Keuangan Mingguan (Engine Kanonikal)*',\n  ''\n];\n\nif (health && health.total_score !== undefined) {\n  lines.push('Skor Kesehatan: ' + health.total_score + '/100 (' + health.grade + ')');\n  if (health.components && health.components.length) {\n    const worst = health.components.reduce((a, b) => (a.score <= b.score ? a : b));\n    lines.push('Komponen terlemah: ' + worst.explanation);\n  }\n  lines.push('');\n}\n\nconst cards = (insights && insights.insights) || [];\nif (cards.length === 0) {\n  lines.push('Belum ada wawasan untuk minggu ini.');\n} else {\n  cards.forEach((card) => {\n    const sev = severityLabel[card.severity] || card.severity;\n    lines.push('[' + sev + '] ' + (card.title || card.type));\n    if (card.explanation) lines.push(card.explanation);\n    if (card.refs && card.refs.endpoint) lines.push('Sumber: ' + card.refs.endpoint);\n    lines.push('');\n  });\n}\n\nreturn [{ json: { text: lines.join('\\n') } }];"
      },
      "id": "code-compose-digest-id",
      "name": "Code - Compose Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "=@alpha_finance_alerts",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-digest-id",
      "name": "Telegram Bot - Weekly Digest",
