# Finance Tracker — Environment Variables
# ========================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ── Security (CIA Triad) ──────────────────────────────────────────────────────

# Master API key — required in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FINANCE_TRACKER_API_KEY=

# Set to "1" ONLY for local development to skip API key auth.
# NEVER set in production.
FINANCE_TRACKER_DEV_MODE=0

# Rate limit: max requests per minute per IP (default: 60)
FINANCE_TRACKER_RATE_LIMIT=60

# Allowed CORS origins (comma-separated). Restrict in production.
FINANCE_TRACKER_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── HTTPS / TLS ───────────────────────────────────────────────────────────────

# Server bind address (0.0.0.0 = semua interface, termasuk LAN)
FINANCE_TRACKER_HOST=0.0.0.0

# HTTP port (default 8444)
FINANCE_TRACKER_PORT=8444

# Path ke TLS certificate dan private key
# Generate dengan: python generate_cert.py
FINANCE_TRACKER_CERT=certs/server.crt
FINANCE_TRACKER_KEY=certs/server.key



# Anthropic API key (optional — falls back to Ollama/rules if not set)
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama host (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Gemini API key (optional — falls back to Ollama/rules if not set)
# GEMINI_API_KEY=AIzaSy...
# VITE_GEMINI_API_KEY=AIzaSy... (optional, if frontend needs direct access)

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────

# PostgreSQL Configuration (Clean Architecture Persistence)
# dbname, user, password, host, port default: finance_tracker, postgres, postgres, localhost, 5432
# POSTGRES_DB=finance_tracker
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ── Telegram Bot ─────────────────────────────────────────────────────────────

# Bot token from @BotFather — required for telegram_bot.py webhook
TELEGRAM_BOT_TOKEN=

# Random secret set in Telegram's setWebhook secret_token field.
TELEGRAM_WEBHOOK_SECRET=

# Port for standalone bot mode (default: 8445, used only if run separately)
TELEGRAM_BOT_PORT=8445
